# --- Sanity CMS (your site's backend / Studio at /studio) ---
# Get these from https://www.sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Contact form email ---
# Get a free API key at https://resend.com after verifying a sending domain
# (or use their default onboarding@resend.dev sender for testing).
RESEND_API_KEY=

# Where contact form submissions should land. Defaults to data/site.json "email".
CONTACT_TO_EMAIL=hello@sharanpreetsingh.com

# Optional: verified "from" address once you've set up a domain in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
